# Copy to .env and fill in.  cp .env.example .env

# Postgres.
# Leave DATABASE_URL unset for local dev: `pnpm dev` runs an embedded Postgres (PGlite) in ./.data — no Docker.
# For Neon / a real Postgres, set the pooled URL here and the direct URL below.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# DATABASE_URL_UNPOOLED=   # direct connection for migrations (Neon)

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000

# First admin account (used by pnpm db:seed only)
SEED_ADMIN_EMAIL=admin@rhu.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Later phases
# BLOB_READ_WRITE_TOKEN=
# CRON_SECRET=
# RESEND_API_KEY=
# SENTRY_DSN=
